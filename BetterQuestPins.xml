<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="BetterQuestPins.lua"/>

	<Button name="BetterQuestPinsPinTemplate" mixin="BetterQuestPinsPinMixin" hidden="true" virtual="true">
		<Size x="22" y="22"/>
		<HitRectInsets>
			<AbsInset left="4" right="4" top="0" bottom="0"/>
		</HitRectInsets>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Texture" atlas="QuestNormal" setAllPoints="true"/>
			</Layer>
		</Layers>
		<!-- No scripts: the map canvas calls OnLoad, OnMouseEnter, OnMouseLeave and
		     OnClick itself, and asserts when a new pin brings its own OnEnter/OnLeave. -->
	</Button>
</Ui>
